# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# OpenAI (chat / generation — Phase 1.6+)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (embeddings — Phase 1.3.c)
# Get a key at https://aistudio.google.com/app/apikey (free tier covers the embedding model below).
GOOGLE_API_KEY=replace-me
# Provider selector (only 'gemini' supported for now; reserved for future swap).
EMBEDDING_PROVIDER=gemini
# Embedding model id. gemini-embedding-001 is the current production model and
# returns 3072-dim vectors. text-embedding-004 was retired from the v1beta API
# in early 2026 (404s — see EmbedderService SDK-bug guard).
EMBEDDING_MODEL=gemini-embedding-001
# Max chunks sent per Gemini API call (1..100).
EMBEDDING_BATCH_SIZE=100
# Max simultaneous in-flight batches (1..20). Balanced with token-bucket gate below.
EMBEDDING_CONCURRENCY=2

# === Rate limiting (two-layer: token bucket + adaptive retry) ===
# Tier 1 safe defaults. Increase RPM for higher tiers:
#   Tier 1 (free):       15  → ~50 min for 53K vectors
#   Tier 2 ($250 spend): 60  → ~15 min
#   Tier 3 ($1k+ spend): 200 → ~10 min
EMBEDDING_REQUESTS_PER_MINUTE=15
# How many times to retry a single batch on transient errors (429 / SDK
# silent-swallow). Each attempt also re-acquires a token bucket slot.
EMBEDDING_RETRY_MAX_ATTEMPTS=10
# Adaptive backoff: starts low (we only retry when token bucket overshot), grows
# by EMBEDDING_RETRY_GROWTH_FACTOR until EMBEDDING_RETRY_MAX_DELAY_MS cap.
EMBEDDING_RETRY_INITIAL_DELAY_MS=200
EMBEDDING_RETRY_MAX_DELAY_MS=2000
EMBEDDING_RETRY_GROWTH_FACTOR=1.5

# Chroma vector store (Phase 1.3.e) ---------------------------------
# Local dev: docker compose up -d chroma  →  http://localhost:8000
# Different VM (same datacenter): set to http://chroma.internal:8000
# Chroma Cloud: set to https://<your-instance>.chroma.run and fill CHROMA_API_KEY below.
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=podcasts
# Distance metric. EmbedderService normalizes every vector to unit length,
# which makes L2 mathematically equivalent to cosine for retrieval ranking
# (cos(a,b) = 1 − L2²(a,b)/2 when ||a|| = ||b|| = 1). The chromadb JS client
# 1.10.x cannot configure HNSW space, so we leave Chroma's default L2 in
# place and lean on normalization. Change only if you know what you're doing.
CHROMA_DISTANCE_METRIC=l2
# Vectors per upsert call. Default 500 is balanced. Cloud / high-latency: try 1000-2000.
CHROMA_WRITE_BATCH_SIZE=500
# Parallel in-flight batches via p-limit (semaphore).
# Local same-host: 3 (default). Different VM: 5. Chroma Cloud: 10.
CHROMA_WRITE_CONCURRENCY=3
# Per-batch HTTP timeout in ms. Cloud / cross-region: bump to 60000.
CHROMA_WRITE_TIMEOUT_MS=30000
# Retry attempts on transient errors (429, 5xx, timeouts) per batch.
CHROMA_WRITE_MAX_RETRIES=3
# Auth — leave blank for local Chroma. Required for Chroma Cloud.
CHROMA_API_KEY=
# Header used to carry the API key. Chroma Cloud default is X-Chroma-Token.
CHROMA_API_KEY_HEADER=X-Chroma-Token

# Text cleaning (Phase 1.3.d) — deterministic regex-based normalization between load and chunk.
# Level 1 normalization (unicode, whitespace, punctuation, sentence dedup) is always on.
# Strip Lex Fridman "And now, dear friends, here's <Guest>." intro sentence.
CLEANING_REMOVE_INTRO=true
# Strip Lex Fridman "Thank you for listening to this conversation with <Guest>..." outro.
CLEANING_REMOVE_OUTRO=true
# Sponsor segments — placeholder, deferred to Phase 2 once evaluation can measure impact.
CLEANING_REMOVE_SPONSORS=false
# Filler words ("um", "uh") — placeholder, deferred to Phase 2.
CLEANING_REMOVE_FILLERS=false

# === Retrieval (Phase 1.5) ===
# Default number of chunks returned per query.
RETRIEVAL_DEFAULT_TOP_K=5
# Hard upper bound on topK to protect downstream LLM context window.
RETRIEVAL_MAX_TOP_K=50
# Reject queries shorter than this many characters (after trim).
RETRIEVAL_MIN_QUERY_LENGTH=3
# Reject queries longer than this many characters (DoS guard).
RETRIEVAL_MAX_QUERY_LENGTH=1000

# === LLM (Phase 1.6) — chat model for the QA chain. Reuses GOOGLE_API_KEY. ===
# Model id. gemini-2.5-flash-lite is the current default: free-tier friendly,
# ~390 tok/s, $0.10/$0.40 per 1M (in/out), 1M ctx, GA stability.
# Note: gemini-2.0-flash was deprecated for new accounts on 2026-03-06
# (returns 404). Pin a specific version (avoid the `-latest` alias) so
# retrieval + answer quality stay reproducible until Phase 2 evaluation.
LLM_MODEL=gemini-2.5-flash-lite
# 0 = deterministic. RAG best practice: low temperature minimizes hallucination.
LLM_TEMPERATURE=0
# Maximum answer length (tokens). 1024 ≈ 700–800 words.
LLM_MAX_OUTPUT_TOKENS=1024
# Reserved for a future Promise.race timeout wrapper around chain.invoke.
# ChatGoogleGenerativeAI does not honour this directly today.
LLM_TIMEOUT_MS=30000

# === QA chain (Phase 1.6) ===
# Default chunks pulled from retriever to feed LLM context.
QA_DEFAULT_TOP_K=5
# Max characters surfaced in each source excerpt; longer chunks get "..." appended.
QA_SOURCE_EXCERPT_LENGTH=200

# === Redis (Phase 1.7.5 Sprint A) ==================================
# Local dev: docker compose up -d redis  →  localhost:6379
# Used by the distributed ingestion lock + integrity marker. Sprint B
# will add a multi-layer cache on top. If Redis is unreachable, the
# query path / startup integrity check fail-open with a warning log —
# the service stays up.
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank when running the default Docker image; set when using a
# managed Redis (Upstash, ElastiCache, MemoryStore).
REDIS_PASSWORD=
# Logical DB index (0-15). Keep 0 unless sharing one Redis with other apps.
REDIS_DB=0
# Initial connect timeout. ioredis retries automatically after this point.
REDIS_CONNECTION_TIMEOUT_MS=5000

# === Ingestion lock (Phase 1.7.5 Sprint A) ===
# Lock TTL — the absolute crash safety net. If the ingest process dies
# without releasing, the lock auto-expires after this many seconds.
# 2 h covers the worst-case full Lex Fridman ingestion on Tier 1 quota.
INGESTION_LOCK_TTL_SECONDS=7200
# Refresh cadence — the worker extends its lock every N ms so a long
# ingestion never naturally expires while work continues. 5 min gives
# ~24 refreshes during a 2 h run with comfortable margin.
INGESTION_LOCK_REFRESH_INTERVAL_MS=300000
