# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# OpenAI (chat / generation — Phase 1.6+)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (embeddings — Phase 1.3.c)
# Get a key at https://aistudio.google.com/app/apikey (free tier covers text-embedding-004).
GOOGLE_API_KEY=replace-me
# Provider selector (only 'gemini' supported for now; reserved for future swap).
EMBEDDING_PROVIDER=gemini
# Embedding model id; text-embedding-004 returns 768-dim vectors.
EMBEDDING_MODEL=text-embedding-004
# Max chunks sent per Gemini API call (1..100).
EMBEDDING_BATCH_SIZE=100
# Max simultaneous in-flight batches (1..20).
EMBEDDING_CONCURRENCY=5

# Chroma (local persistence — Phase 1.3.d)
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=podcasts
