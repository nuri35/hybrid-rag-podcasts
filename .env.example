# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# OpenAI (chat / generation — Phase 1.6+)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (embeddings — Phase 1.3.c)
# Get a key at https://aistudio.google.com/app/apikey (free tier covers text-embedding-004).
GOOGLE_API_KEY=replace-me
# Provider selector (only 'gemini' supported for now; reserved for future swap).
EMBEDDING_PROVIDER=gemini
# Embedding model id; text-embedding-004 returns 768-dim vectors.
EMBEDDING_MODEL=text-embedding-004
# Max chunks sent per Gemini API call (1..100).
EMBEDDING_BATCH_SIZE=100
# Max simultaneous in-flight batches (1..20).
EMBEDDING_CONCURRENCY=5

# Chroma (local persistence — Phase 1.3.e)
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=podcasts

# Text cleaning (Phase 1.3.d) — deterministic regex-based normalization between load and chunk.
# Level 1 normalization (unicode, whitespace, punctuation, sentence dedup) is always on.
# Strip Lex Fridman "And now, dear friends, here's <Guest>." intro sentence.
CLEANING_REMOVE_INTRO=true
# Strip Lex Fridman "Thank you for listening to this conversation with <Guest>..." outro.
CLEANING_REMOVE_OUTRO=true
# Sponsor segments — placeholder, deferred to Phase 2 once evaluation can measure impact.
CLEANING_REMOVE_SPONSORS=false
# Filler words ("um", "uh") — placeholder, deferred to Phase 2.
CLEANING_REMOVE_FILLERS=false
